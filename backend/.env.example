# Copy to backend/.env and fill in real values. Never commit .env.
DB_URL=jdbc:postgresql://<host>:5432/<db>?sslmode=require
DB_USERNAME=<user>
DB_PASSWORD=<password>

# Base64-encoded 256-bit key. Generate with: openssl rand -base64 32
JWT_SECRET=<base64-secret>

RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=<secret>

# true = accept the frontend's simulated "mock_signature_test" payment (local demo only)
PAYMENT_SIMULATION_ENABLED=false

ML_SERVICE_URL=http://127.0.0.1:8000
